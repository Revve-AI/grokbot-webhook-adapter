# Placeholders only. Set real values in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# --- Fathom ---
# Fathom > Settings > API Access > Manage > your webhook: the "whsec_..." secret shown for it
FATHOM_WEBHOOK_SECRET=whsec_REPLACE_ME
# Grok Bot routine panel > Webhook URL
FATHOM_TARGET_URL=https://REPLACE_ME
# Grok Bot routine panel > Webhook key (bare key; a value starting with "Bearer " also works)
FATHOM_TARGET_KEY=REPLACE_ME

# --- GitHub example (optional; disabled until all three are set) ---
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TARGET_URL=
# GITHUB_TARGET_KEY=

# --- Stripe example (optional; disabled until all three are set) ---
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TARGET_URL=
# STRIPE_TARGET_KEY=
